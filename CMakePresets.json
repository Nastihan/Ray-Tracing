{
    "version": 2,
    "configurePresets": [
        {
            "name": "Base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/build/${presetName}",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build/${presetName}",
                "CMAKE_CXX_STANDARD": "17",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/${presetName}"
            }
        },
        {
            "name": "Windows-Base",
            "inherits": "Base",
            "hidden": true,
            "generator": "Ninja",
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_ROOT}/installed/x64-windows;$env{VCPKG_ROOT}/installed/x64-windows-static"
            }
        },
        {
            "name": "MacOS-Base",
            "inherits": "Base",
            "hidden": true,
            "generator": "Xcode",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "/usr/bin/clang",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
                "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_ROOT}/installed/uni-osx",
                "CMAKE_VERBOSE_MAKEFILE": "OFF"
            }
        },
        {
            "name": "Linux-Base",
            "inherits": "Base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER_WORKS": "ON",
                "CMAKE_CXX_COMPILER_WORKS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_ROOT}/installed/x64-linux"
            }
        },
        {
            "name": "Windows-Debug",
            "inherits": "Windows-Base",
            "displayName": "Windows Debug",
            "description": "Windows Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Windows-Release",
            "inherits": "Windows-Base",
            "displayName": "Windows Release",
            "description": "Windows Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "MacOS-Debug",
            "inherits": "MacOS-Base",
            "displayName": "MacOS - Debug",
            "description": "Using compilers: C = /usr/bin/clang, CXX = /usr/bin/clang++",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug",
                "CMAKE_LIBRARY_OUTPUT_DIRECTORY_DEBUG": "${sourceDir}/build/${presetName}",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY_DEBUG": "${sourceDir}/build/${presetName}",
                "CMAKE_ARCHIVE_OUTPUT_DIRECTORY_DEBUG": "${sourceDir}/build/${presetName}"
            }
        },
        {    
            "name": "MacOS-Release",
            "inherits": "MacOS-Base",
            "displayName": "MacOS - Release",
            "description": "Using compilers: C = /usr/bin/clang, CXX = /usr/bin/clang++",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Release",
                "CMAKE_LIBRARY_OUTPUT_DIRECTORY_RELEASE": "${sourceDir}/build/${presetName}",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE": "${sourceDir}/build/${presetName}",
                "CMAKE_ARCHIVE_OUTPUT_DIRECTORY_RELEASE": "${sourceDir}/build/${presetName}"
            }
        },
        {
            "name": "Linux-Debug",
            "inherits": "Linux-Base",
            "displayName": "Linux - Debug",
            "description": "",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Linux-Release",
            "inherits": "Linux-Base",
            "displayName": "Linux - Release",
            "description": "",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Windows-Debug",
            "configurePreset": "Windows-Debug"
        },
        {
            "name": "Windows-Release",
            "configurePreset": "Windows-Release"
        },           
        {
            "name": "MacOS-Debug",
            "configurePreset": "MacOS-Debug",
            "configuration": "Debug"
        },
        {
            "name": "MacOS-Release",
            "configurePreset": "MacOS-Release",
            "configuration": "Release",
            "nativeToolOptions": ["-quiet"]
        },
        {
            "name": "Linux-Debug",
            "configurePreset": "Linux-Debug"
        },
        {
            "name": "Linux-Release",
            "configurePreset": "Linux-Release"
        }
    ]
}